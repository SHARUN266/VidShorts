# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc & OS
.DS_Store
Thumbs.db
*.pem

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# environment variables
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large media & video files (Never commit videos to Git!)
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/raw/.gitkeep
!/public/uploads/rendered/.gitkeep
!/public/uploads/temp_clips/.gitkeep
!/public/uploads/audio/.gitkeep
*.mp4
*.m4a
*.mp3
*.wav
*.webm
*.avi
*.mov
*.mkv

# SQLite databases
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm
!/data/.gitkeep

# Temporary and cache folders
/tmp/
.cache/
