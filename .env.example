# VidShot Personal Environment Variables Example
# Copy this file to .env.local and fill in the values.

# Database
# Note: For SQLite local db, the path is already resolved automatically via lib/db/drizzle.ts
# but you can customize it here if you wish:
# DATABASE_URL=data/vidshot.db

# Deepgram Speech-to-Text API Key
# Sign up at https://console.deepgram.com to get your API key.
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Google Gemini API Key
# Sign up at https://aistudio.google.com to get your API key.
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API v3 OAuth Credentials (Required for Phase 5 Direct Uploads)
# Create OAuth 2.0 Client ID in Google Cloud Console with YouTube Data API v3 enabled
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

